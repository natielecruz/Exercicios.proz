<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Uber</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            background: black;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .card {
            background: black;
            width: 325px;
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 15px 30px rgba(0, 0, 0, .3);
            text-align: center;
        }

        .titulo-container {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
        }

        .logo-titulo {
            width: 35px;
            height: auto;
        }

        h1 {
            color: white;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        input {
            color: #D3D3D3;
            width: 100%;
            background-color: rgba(250, 249, 249, 0.3);
            padding: 14px;
            margin: 10px 0;
            border-radius: 8px;
            border: 1px solid rgba(128, 128, 128, 0.3);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            outline: none;
        }

        input::placeholder {
            color: white;
        }

        button {
            width: 100%;
            padding: 15px;
            margin-top: 20px;
            border: 1px solid #D3D3D3;
            border-radius: 10px;
            background: black;
            color: white;
            cursor: pointer;
            transition: .3s;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        button:hover {
            background: white;
            color: black;
        }

        h5 {
            text-align: left;
            color: white;
            font-size: 10px;
        }
    </style>
</head>

<body>

    <div class="card">
        
        <div class="titulo-container">
            <img src="logo.png" alt="Logo Uber" class="logo-titulo">
            <h1>Uber</h1>
        </div>

        <form id="meuFormulario">
            <h5>NOME</h5>
            <input type="text" id="nome" required placeholder="Nome completo">

            <h5>EMAIL</h5>
            <input type="email" id="email" required placeholder="exemplo@email.com">

            <h5>SENHA</h5>
            <input type="password" id="senha" required placeholder="Senha">

            <button type="submit">Entrar</button>
        </form>
    </div>

    <script src="script.js"></script>
</body>

</html>
